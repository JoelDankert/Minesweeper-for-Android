    <string name="info_theme_mode">Chooses whether the app uses the system theme, always light, or always dark.</string>
    <string name="info_theme_color">Changes the board and UI accent color. It previews now and saves when you tap Apply.</string>
    <string name="info_language">Changes the app language. System follows your device language and falls back to English.</string>
    <string name="info_flag_mode_default">New games start in flag mode instead of reveal mode.</string>
    <string name="info_enable_cording">Tapping a revealed number opens nearby hidden tiles when the right number of flags is placed.</string>
    <string name="info_vibrate_enabled">Adds haptic feedback for game actions.</string>
    <string name="info_amoled_theme">Uses full black surfaces whenever dark mode is active.</string>
    <string name="info_show_bottom_toggle">Shows the reveal/flag input toggle at the bottom of the game screen.</string>
    <string name="info_show_top_clears">Shows the best cleared scores in the game end panel.</string>
    <string name="info_show_mine_density">Shows mine density instead of only mine count where modes are summarized. Min Fade and Max Fade control the density range used for the color fade.</string>
    <string name="info_show_recent_modes_button">Shows the Show more button on the home screen for modes played before but not saved.</string>
    <string name="info_round_corners">Rounds the visible tile corners.</string>
    <string name="info_merge_tiles">Merges touching revealed tiles into larger shapes when rounded corners are enabled.</string>
    <string name="info_fill_gaps">Fills tiny visual gaps between merged or square tiles.</string>
    <string name="info_long_press_delay">Sets how long you must hold a tile before it counts as a long press. A long press uses the opposite action: flag while reveal mode is active, reveal while flag mode is active.</string>
    <string name="info_animation_speed">Controls how fast reveal and mine animations play.</string>
    <string name="info_restore_default_modes">Marks the default game modes to be restored when you tap Apply on the main settings screen.</string>
    <string name="info_clear_all_scores">Deletes every saved score after confirmation.</string>
    <string name="info_screen_shake">Shakes the board briefly when a mine is hit.</string>
