<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mode"
        android:textColor="@color/ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/mode_subtitle"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/nameInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_input"
        android:hint="@string/name"
        android:imeOptions="actionNext"
        android:inputType="textCapWords"
        android:padding="12dp"
        android:selectAllOnFocus="true"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_soft" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/widthInput"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/width"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:padding="12dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft" />

        <EditText
            android:id="@+id/heightInput"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/height"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:padding="12dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft" />
    </LinearLayout>

    <EditText
        android:id="@+id/minesInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:hint="@string/mines"
        android:imeOptions="actionDone"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:selectAllOnFocus="true"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_soft" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/noGuessSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/no_guess_mode"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/mode_error"
        android:textColor="@color/error"
        android:visibility="gone" />

</LinearLayout>
</ScrollView>
