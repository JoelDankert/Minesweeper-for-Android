<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back_material" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/advanced"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/amoledTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:switchPadding="14dp"
                android:text="@string/amoled_theme" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/showBottomToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:switchPadding="14dp"
                android:text="@string/show_bottom_toggle" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/showTopClears"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:switchPadding="14dp"
                android:text="@string/show_top_clears" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/showMineDensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:switchPadding="14dp"
                android:text="@string/show_mine_density" />

            <LinearLayout
                android:id="@+id/mineDensityFadeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/mineDensityMinFadeInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="@string/min_fade"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:padding="14dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/mineDensityMaxFadeInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:hint="@string/max_fade"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:padding="14dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textSize="16sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/roundCorners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:switchPadding="14dp"
                android:text="@string/round_corners" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/mergeTiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:switchPadding="14dp"
                android:text="@string/merge_tiles" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/fillGaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:switchPadding="14dp"
                android:text="@string/fill_gaps" />

            <LinearLayout
                android:id="@+id/longPressRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/longPressLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/long_press_delay"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/longPressValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="250 ms"
                        android:textSize="14sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/longPressSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="9"
                    android:progress="4" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/animationSpeedRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/animationSpeedLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/animation_speed"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/animationSpeedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50%"
                        android:textSize="14sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/animationSpeedSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="50" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/screenShake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:switchPadding="14dp"
                android:text="@string/screen_shake" />

            <LinearLayout
                android:id="@+id/restoreModesButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/restoreModesLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/default_modes"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/restoreModesValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/restore"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/clearAllScoresButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/clearAllScoresLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/all_scores"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/clearAllScoresValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
